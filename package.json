{
  "name": "iris",
  "version": "1.0.0",
  "description": "Iris // High-contrast studio audio visualizer with desktop loopback",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.iris.audiovisualizer",
    "productName": "Iris",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Iris Audio Visualizer"
    }
  },
  "keywords": [
    "iris",
    "audio-visualizer",
    "spectrum",
    "oscilloscope",
    "spectrogram",
    "stereometer",
    "vu-meter",
    "waveform",
    "loudness"
  ],
  "author": "Miguel",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
